# Enquiry form (api/enquiry.js). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Inbox(es) that receive enquiries, comma-separated
ENQUIRY_TO=inventfineart.mum@gmail.com
# Sender on a domain verified in Resend (until then Resend's onboarding@resend.dev is used)
ENQUIRY_FROM="Invent Fine Art <enquiries@inventfineart.com>"

# Optional spam protection (Cloudflare Turnstile). Leave empty to use the honeypot only.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Optional: where this build is served, for link previews (og:image). On Vercel it is worked out automatically.
VITE_PREVIEW_ORIGIN=
